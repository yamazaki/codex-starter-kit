{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-starter-kit/distribution-catalog.schema.json",
  "title": "Codex Starter Kit distribution catalog",
  "type": "object",
  "required": ["schemaVersion", "product", "roots", "profiles", "languages", "components", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "codex-starter-kit" },
    "roots": {
      "type": "array",
      "const": ["codexHome", "agentsHome"]
    },
    "profiles": {
      "type": "array",
      "const": ["minimal", "standard", "full"]
    },
    "languages": {
      "type": "array",
      "const": ["ja", "en"]
    },
    "components": {
      "type": "array",
      "const": ["safety-net"]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sources", "profiles", "root", "target"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "sources": {
            "type": "object",
            "required": ["ja", "en"],
            "properties": {
              "ja": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["minimal", "standard", "full"] }
          },
          "components": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["safety-net"] }
          },
          "root": { "enum": ["codexHome", "agentsHome"] },
          "target": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
          "template": { "enum": ["hook-command"] },
          "scriptTarget": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
