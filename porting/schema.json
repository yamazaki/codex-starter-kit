{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-starter-kit/porting-catalog.schema.json",
  "title": "Codex Starter Kit porting catalog",
  "type": "object",
  "required": ["schemaVersion", "defaultDisposition", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultDisposition": {
      "enum": ["KEEP", "ADAPT", "REVIEW", "DROP", "BLOCKED"]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "patterns", "disposition", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "disposition": {
            "enum": ["KEEP", "ADAPT", "REVIEW", "DROP", "BLOCKED"]
          },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
