  "targetVersion": "0.79.2",
  "requirements": [
    {
      "id": "cli-stdin",
      "disposition": "DROP",
      "sourceRequirement": "非対話Claude plugin/mcpのstdin分離",
      "decision": "Claude CLI/pluginを実行しない。Codex release取得はspawnSyncのpipe入力と非対話envを使用。Bunのtty修正は対象外。",
      "targets": [
        "scripts/lib/kit-update.mjs"
      ]
    },
    {
      "id": "cli-uninstall",
      "disposition": "DROP",
      "sourceRequirement": "Claude本体削除の固定path・親symlink検査・失敗報告",
      "decision": "CLI本体削除を提供しない。kit管理対象の削除はmanifest・root・snapshotで限定する。",
      "targets": [
        "scripts/distribution-lib.mjs",
        "tests/installer-update-guard.test.mjs"
      ]
    },
    {
      "id": "dependency-security",
      "disposition": "DROP",
      "sourceRequirement": "undici/source-map-jsのlockfile修正版とMDM bundle pin",
      "decision": "web-content-extraction runtimeは非同梱。修正対象の依存/実行経路なし。Skill追加はしない。",
      "targets": [
        "porting/skill-map.json",
        "porting/feature-map.json",
        "distribution/catalog.json"
      ]
    },
    {
      "id": "legacy-hooks",
      "disposition": "DROP",
      "sourceRequirement": "Claude <2.1.89 hook/cache/schema退役と既存設定の移行",
      "decision": "Claude legacy Hookを配布しない。Codex native updaterを削除しない。旧source inventoryは履歴として保持し、削除fileをdeltaに明記。",
      "targets": [
        "porting/feature-map.json",
        "porting/fidelity-contract.json"
      ]
    },
    {
      "id": "lock-preflight",
      "disposition": "ADAPT",
      "sourceRequirement": "バックアップ・管理対象書換え前の競合検知",
      "decision": "既存共通lock取得を保持。read-only previewはlockを取得せず、停止要因があればblockedを返してsource取得も行わない。",
      "targets": [
        "porting/candidates/0.79.2/scripts/lib/kit-update.mjs",
        "tests/upstream-0792.test.mjs"
      ]
    },
    {
      "id": "lock-diagnosis",
      "disposition": "ADAPT",
      "sourceRequirement": "lock path/owner/時刻/PID状態と停止理由を提示",
      "decision": "bounded reimplementation。pid/startedAtだけを検証して提示。owner raw本文を出さず、不正・過大・symlinkは不明扱い。PID存在は所有権証明ではない。",
      "targets": [
        "porting/candidates/0.79.2/scripts/lib/installation-lock.mjs",
        "tests/upstream-0792.test.mjs"
      ]
    },
    {
      "id": "lock-recovery",
      "disposition": "ADAPT",
      "sourceRequirement": "途中状態・再実行・手動復旧の案内",
      "decision": "safe operational alternative。稼働更新なしを確認しjournal/manifest/snapshotをレビュー、承認後に復旧し同じ入口を再実行。自動削除commandは案内しない。",
      "targets": [
        "docs/UPDATE_WORKFLOW.md",
        "porting/candidates/0.79.2/scripts/auto-update.mjs",
        "tests/upstream-0792.test.mjs"
      ]
    },
    {
      "id": "lock-auto-reclaim",
      "disposition": "DROP",
      "sourceRequirement": "aged dead ownerのmutex/隔離/再照合による自動回収と最大60秒待機",
      "decision": "自動回収を導入しないためreclaim mutex・quarantine・PID/時刻からの削除判定を追加しない。残留lockは証拠として保持。競合時即時停止を維持。",
      "targets": [
        "scripts/lib/installation-lock.mjs",
        "porting/candidates/0.79.2/README.md"
      ]
    },
    {
      "id": "wce-lock-scope",
      "disposition": "DROP",
      "sourceRequirement": "npm viewをlock外、適用直前の再確認、失敗timer再試行・signal解放・package pair整合",
      "decision": "非同梱WCE依存updater用。Codexのrelease取得・自動checkは共通lock下を維持（check stampと登録runtimeの共有状態を含む）。別runtimeを同等実装と呼ばない。",
      "targets": [
        "scripts/lib/kit-update.mjs",
        "porting/skill-map.json"
      ]
    },
    {
      "id": "baseline-refresh",
      "disposition": "DROP",
      "sourceRequirement": "CLAUDE.md本文が新規版と同一ならsnapshotのみ修復",
      "decision": "marker/3-way merge専用。Codexではjournalが残れば停止し、manifest不一致はCONFLICT。本文一致を根拠に管理記録を黙って修復しない。",
      "targets": [
        "scripts/distribution-lib.mjs",
        "scripts/lib/kit-update.mjs"
      ]
    },
    {
      "id": "permission-retirement",
      "disposition": "ADAPT",
      "sourceRequirement": "無効な7件のWrite(path) deny除去と利用者設定保持",
      "decision": "source対応記録のみ。CodexにはClaude permission JSONを配置しない。7件の削除とEdit保護の残存を記録し、旧permissions-mapは受入baselineの履歴を保持。",
      "targets": [
        "porting/permissions-map.json",
        "porting/upstream-0792-delta.json"
      ]
    },
    {
      "id": "mdm",
      "disposition": "DROP",
      "sourceRequirement": "MDM期待hash・async schema・renderer整合",
      "decision": "MDMは今回も配布scope外。組織管理機能の採用時に再評価。",
      "targets": [
        "porting/catalog.json"
      ]
    },
    {
      "id": "supporting-resources",
      "disposition": "ADAPT",
      "sourceRequirement": "日本語/英語案内・commands・README・upstream境界試験",
      "decision": "Codex用手順と追加試験へ再構成。Claude shell suiteの直接実行・Skillの新設なし。",
      "targets": [
        "docs/UPDATE_WORKFLOW.md",
        "tests/upstream-0792.test.mjs"
      ]
    }
  ],
